default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    increment_build_number(
      build_number: ENV["BUILD_NUMBER"],
      xcodeproj: "ExpenseTracker.xcodeproj"
    )

    build_app(
      scheme: "ExpenseTracker",
      project: "ExpenseTracker.xcodeproj",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        teamID: ENV["APPLE_TEAM_ID"],
        signingStyle: "manual",
        provisioningProfiles: {
          "com.expensetracker.kafy" => ENV["APPLE_PROVISIONING_PROFILE_NAME"]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
